{
  "appId": "boats.lulu.game",
  "appName": "Lulu's Road Trip",
  "webDir": "www",
  "server": {
    "appStartPath": "/3d/index.html"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#1a1a2e"
  },
  "plugins": {
    "AdMob": {
      "initializeForTesting": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "directUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "allowModifyUrl": false,
      "persistModifyUrl": false,
      "allowPreview": false,
      "shakeMenu": false,
      "autoSplashscreen": false,
      "httpsOnly": true,
      "appReadyTimeout": 40000,
      "responseTimeout": 30,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "keepUrlPathAfterReload": false,
      "disableJSLogging": true
    }
  }
}
